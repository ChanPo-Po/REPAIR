/* POPOPHONE Repair V8 - Google Apps Script API
Deploy: Apps Script > Deploy > Web app > Execute as Me > Anyone.
Set SHEET_ID rồi dán Web App URL vào js/config.js.
*/
const SHEET_ID = 'PASTE_SPREADSHEET_ID_HERE';
const SHEET_DATA = 'DATA';
const SHEET_LOG = 'LOG_SUA_CHUA';
const HEADERS_DATA = ['Mã sửa chữa','IMEI','Ngày nhận','Chi nhánh nhận','Sản phẩm','Tên khách hàng','Số điện thoại','Loại dịch vụ','Tình trạng khi nhận máy','Yêu cầu sửa chữa','Ghi chú tiếp nhận','Hẹn trả','FaceID','Màn hình','Camera/Mic','Loa','Giá dự kiến','Nhân viên tiếp nhận','Tình trạng thực tế','Nơi xử lý','Kỹ thuật xử lý','Trạng thái máy','Ngày hoàn thành','Ngày bàn giao','Trễ hẹn','Ghi chú kỹ thuật','Tổng tiền dịch vụ','Tổng giá vốn vật tư','Tổng công thợ','Chi phí phát sinh','Tổng chi phí','Thực thu','Lợi nhuận','Trạng thái thanh toán','Nội dung phát sinh','Năm','Tháng','Tuần','Ngày tạo','Ngày cập nhật'];
function doPost(e){try{setupSheets();const body=JSON.parse(e.postData.contents||'{}');const action=body.action;if(action==='createRepair')return json(createRepair(body.data));if(action==='list')return json({success:true,data:listRepairs()});if(action==='search')return json({success:true,data:searchRepairs(body.q)});if(action==='updateStatus')return json(updateStatus(body.repairId,body.data));if(action==='updateCost')return json(updateCost(body.repairId,body.data));return json({success:false,message:'Unknown action'});}catch(err){return json({success:false,message:String(err)})}}
function doGet(){setupSheets();return json({success:true,message:'POPOPHONE Repair V8 API OK'})}
function ss(){return SpreadsheetApp.openById(SHEET_ID)}
function sh(name){return ss().getSheetByName(name)}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function setupSheets(){const book=ss();let data=book.getSheetByName(SHEET_DATA);if(!data)data=book.insertSheet(SHEET_DATA);if(data.getLastRow()<1)data.appendRow(HEADERS_DATA);let log=book.getSheetByName(SHEET_LOG);if(!log)log=book.insertSheet(SHEET_LOG);if(log.getLastRow()<1)log.appendRow(['ID','Mã sửa chữa','Thời gian','Người thực hiện','Hành động','Nội dung']);}
function getMap(){const h=sh(SHEET_DATA).getRange(1,1,1,sh(SHEET_DATA).getLastColumn()).getValues()[0];const m={};h.forEach((x,i)=>m[x]=i);return m}
function rowToObj(r,m){return {repairId:r[m['Mã sửa chữa']],imei:r[m['IMEI']],date:r[m['Ngày nhận']],branch:r[m['Chi nhánh nhận']],product:r[m['Sản phẩm']],customer:r[m['Tên khách hàng']],phone:r[m['Số điện thoại']],serviceType:r[m['Loại dịch vụ']],receiveStatus:r[m['Tình trạng khi nhận máy']],request:r[m['Yêu cầu sửa chữa']],receiveNote:r[m['Ghi chú tiếp nhận']],appointment:r[m['Hẹn trả']],faceId:r[m['FaceID']],screen:r[m['Màn hình']],cameraMic:r[m['Camera/Mic']],speaker:r[m['Loa']],estimate:r[m['Giá dự kiến']],staff:r[m['Nhân viên tiếp nhận']],actualStatus:r[m['Tình trạng thực tế']],place:r[m['Nơi xử lý']],technician:r[m['Kỹ thuật xử lý']],status:r[m['Trạng thái máy']],completedDate:r[m['Ngày hoàn thành']],handoverDate:r[m['Ngày bàn giao']],overdue:r[m['Trễ hẹn']],techNote:r[m['Ghi chú kỹ thuật']],serviceTotal:r[m['Tổng tiền dịch vụ']],materialCost:r[m['Tổng giá vốn vật tư']],laborCost:r[m['Tổng công thợ']],extraCost:r[m['Chi phí phát sinh']],totalCost:r[m['Tổng chi phí']],actualRevenue:r[m['Thực thu']],profit:r[m['Lợi nhuận']],paymentStatus:r[m['Trạng thái thanh toán']],extraNote:r[m['Nội dung phát sinh']],year:r[m['Năm']],month:r[m['Tháng']],week:r[m['Tuần']],createdAt:r[m['Ngày tạo']],updatedAt:r[m['Ngày cập nhật']]}}
function listRepairs(){const sheet=sh(SHEET_DATA);const vals=sheet.getDataRange().getValues();if(vals.length<=1)return [];const m=getMap();return vals.slice(1).filter(r=>r[m['Mã sửa chữa']]).map(r=>rowToObj(r,m)).reverse()}
function searchRepairs(q){q=String(q||'').toLowerCase();return listRepairs().filter(x=>JSON.stringify(x).toLowerCase().indexOf(q)>-1).slice(0,50)}
function createRepair(d){const now=new Date();const tz='GMT+7';const id='SC'+Utilities.formatDate(now,tz,'yyMMddHHmmss')+Utilities.getUuid().slice(0,4).toUpperCase();const year=Number(Utilities.formatDate(now,tz,'yyyy'));const month=Number(Utilities.formatDate(now,tz,'M'));const week=Number(Utilities.formatDate(now,tz,'w'));const row=HEADERS_DATA.map(h=>{switch(h){case 'Mã sửa chữa':return id;case 'IMEI':return d.imei||'';case 'Ngày nhận':return Utilities.formatDate(now,tz,'dd/MM/yyyy HH:mm:ss');case 'Chi nhánh nhận':return d.branch||'';case 'Sản phẩm':return d.product||'';case 'Tên khách hàng':return d.customer||'';case 'Số điện thoại':return d.phone||'';case 'Loại dịch vụ':return d.serviceType||'';case 'Tình trạng khi nhận máy':return d.receiveStatus||'';case 'Yêu cầu sửa chữa':return d.request||'';case 'Ghi chú tiếp nhận':return d.receiveNote||'';case 'Hẹn trả':return d.appointment||'';case 'FaceID':return d.faceId||'';case 'Màn hình':return d.screen||'';case 'Camera/Mic':return d.cameraMic||'';case 'Loa':return d.speaker||'';case 'Giá dự kiến':return Number(d.estimate)||0;case 'Nhân viên tiếp nhận':return d.staff||'';case 'Trạng thái máy':return '1. Đã tiếp nhận';case 'Trạng thái thanh toán':return 'Chưa thanh toán';case 'Năm':return year;case 'Tháng':return month;case 'Tuần':return week;case 'Ngày tạo':return Utilities.formatDate(now,tz,'dd/MM/yyyy HH:mm:ss');case 'Ngày cập nhật':return Utilities.formatDate(now,tz,'dd/MM/yyyy HH:mm:ss');default:return h.startsWith('Tổng')||h==='Thực thu'||h==='Lợi nhuận'||h==='Chi phí phát sinh'?0:''}});sh(SHEET_DATA).appendRow(row);addLog(id,d.staff||'Sale','Tiếp nhận','Tạo phiếu tiếp nhận');return {success:true,repairId:id}}
function findRow(id){const sheet=sh(SHEET_DATA);const vals=sheet.getRange(1,1,sheet.getLastRow(),1).getValues().flat();const idx=vals.indexOf(id);return idx>=0?idx+1:-1}
function updateStatus(id,d){const sheet=sh(SHEET_DATA);const row=findRow(id);if(row<2)return {success:false,message:'Không tìm thấy phiếu'};const m=getMap();const set=(h,v)=>sheet.getRange(row,m[h]+1).setValue(v);set('Tình trạng thực tế',d.actualStatus||'');set('Nơi xử lý',d.place||d.processPlace||'');set('Kỹ thuật xử lý',d.technician||'');set('Trạng thái máy',d.status||'');set('Ghi chú kỹ thuật',d.techNote||'');set('Ngày cập nhật',Utilities.formatDate(new Date(),'GMT+7','dd/MM/yyyy HH:mm:ss'));if((d.status||'').startsWith('7.'))set('Ngày hoàn thành',Utilities.formatDate(new Date(),'GMT+7','dd/MM/yyyy HH:mm:ss'));if((d.status||'').startsWith('8.'))set('Ngày bàn giao',Utilities.formatDate(new Date(),'GMT+7','dd/MM/yyyy HH:mm:ss'));addLog(id,d.technician||'Kỹ thuật','Cập nhật trạng thái',d.status||'');return {success:true}}
function updateCost(id,d){const sheet=sh(SHEET_DATA);const row=findRow(id);if(row<2)return {success:false,message:'Không tìm thấy phiếu'};const m=getMap();const material=Number(d.materialCost)||0,labor=Number(d.laborCost)||0,extra=Number(d.extraCost)||0,actual=Number(d.actualRevenue)||0,total=material+labor+extra,profit=actual-total;const set=(h,v)=>sheet.getRange(row,m[h]+1).setValue(v);set('Tổng giá vốn vật tư',material);set('Tổng công thợ',labor);set('Chi phí phát sinh',extra);set('Tổng chi phí',total);set('Thực thu',actual);set('Lợi nhuận',profit);set('Trạng thái thanh toán',d.paymentStatus||'');set('Nội dung phát sinh',d.extraNote||'');set('Ngày cập nhật',Utilities.formatDate(new Date(),'GMT+7','dd/MM/yyyy HH:mm:ss'));addLog(id,'QLKT/Admin','Cập nhật chi phí','Thực thu '+actual+' | Tổng chi phí '+total);return {success:true}}
function addLog(id,user,action,content){sh(SHEET_LOG).appendRow([Utilities.getUuid(),id,Utilities.formatDate(new Date(),'GMT+7','dd/MM/yyyy HH:mm:ss'),user,action,content])}
